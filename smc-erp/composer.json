{
    "name": "smc-dev/smc-erp",
    "description": "SMC ERP",
    "keywords": [
    ],
    "license": "proprietary",
    "type": "library",
    "authors": [
        {
            "name": "Tory Chadwick",
            "email": "torychadwick@icloud.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.0.2",
        "doctrine/dbal": "^3.5",
        "illuminate/support": "^9.0"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0",
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "SMC\\ERP\\": "src",
            "SMC\\ERP\\Api\\": "src",
            "SMC\\ERP\\Api\\Database\\Factories\\": "src/database/factories",
            "SMC\\ERP\\Api\\Database\\Seeders\\": "src/database/seeders"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ERP\\Api\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "SMC\\ERP\\ERPServiceProvider"
            ]
        }
    }
}



