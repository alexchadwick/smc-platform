{
    "name": "smc-dev/smc-training",
    "description": "SMC Training",
    "keywords": ["framework", "laravel"],
    "license": "proprietary",
    "require": {
        "php": ">=8.0.2"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0",
        "phpunit/phpunit": "^9.0",
        "laravel/passport": "^11.6",
        "laravel/sanctum": "^3.2"
    },
    "autoload": {
        "psr-4": {
            "Training\\": "src/",
            "Training\\Api\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Training\\Api\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Training\\TrainingServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    }
}
