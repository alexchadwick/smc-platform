{
    "name": "smc-dev/demo-google-cloud-translate",
    "description": "SMC Demo",
    "keywords": ["framework", "laravel"],
    "license": "proprietary",
    "require": {
        "php": ">=8.0.2",
        "google/cloud-translate": "^1.12"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "Demo\\": "src/",
            "Demo\\Api\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Demo\\Api\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    }
}
